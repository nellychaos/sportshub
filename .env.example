# ─── Database (required) ──────────────────────────────────────────
SPORTSHUB_DATABASE_URL=postgresql+asyncpg://sportshub:sportshub_dev@postgres:5432/sportshub
POSTGRES_PASSWORD=sportshub_dev

# ─── Redis (optional, app degrades gracefully without it) ─────────
SPORTSHUB_REDIS_URL=redis://redis:6379/0

# ─── API ──────────────────────────────────────────────────────────
# Comma-separated list of valid API keys
SPORTSHUB_API_KEYS=sh_dev_changeme_in_production
SPORTSHUB_ENVIRONMENT=development

# ─── Database tuning (optional) ───────────────────────────────────
# SPORTSHUB_DB_POOL_SIZE=10
# SPORTSHUB_DB_MAX_OVERFLOW=5

# ─── Source credentials (all optional) ────────────────────────────
# NBA
SPORTSHUB_BALLDONTLIE_API_KEY=
SPORTSHUB_LOLESPORTS_API_KEY=0TvQnueqKa5mxJntVWt0w4LpLfEkrV1Ta8rQBb9Z

# LoL
SPORTSHUB_PANDASCORE_TOKEN=

# Football
SPORTSHUB_FOOTBALLDATA_API_KEY=

# ─── Betting providers (optional) ─────────────────────────────────
# Cloudbet
SPORTSHUB_CLOUDBET_API_KEY=
# SPORTSHUB_CLOUDBET_API_URL=https://sports-api.cloudbet.com/pub

# Mollybet
SPORTSHUB_MOLLYBET_USERNAME=
SPORTSHUB_MOLLYBET_PASSWORD=
# SPORTSHUB_MOLLYBET_API_URL=https://api.mollybet.com

# External odds confirmation
SPORTSHUB_ODDS_API_KEY=
# SPORTSHUB_ODDS_API_URL=https://api.the-odds-api.com/v4

# ─── LLM entity resolution (optional) ────────────────────────────
# Enable Claude-powered fuzzy matching for event deduplication
SPORTSHUB_LLM_RESOLUTION_ENABLED=false
SPORTSHUB_ANTHROPIC_API_KEY=
# SPORTSHUB_LLM_MODEL=claude-haiku-4-5-20251001
# SPORTSHUB_LLM_ACCEPTANCE_THRESHOLD=0.40
# SPORTSHUB_LLM_COOLDOWN_MINUTES=30

# ─── Logging ──────────────────────────────────────────────────────
SPORTSHUB_LOG_LEVEL=INFO
