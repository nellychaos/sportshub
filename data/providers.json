      },
      "entity_id_format": {
        "team": "numeric (1-30)",
        "player": "numeric (e.g., 4065648)",
        "event": "numeric"
      },
      "abbreviation_map": {
        "our_to_provider": {
          "GSW": "GS",
          "NOP": "NO",
          "NYK": "NY",
          "SAS": "SA",
          "UTA": "UTAH",
          "WAS": "WSH"
        }
      },
      "notes": "Undocumented public API. No auth required. Team abbreviations differ from standard NBA codes. Player stats endpoint returns career history by season with FG made-attempted as combined string (e.g., '9.2-19.5')."
