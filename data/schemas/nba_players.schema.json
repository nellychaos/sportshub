{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NBA Players",
  "description": "Array of NBA player objects with roster data",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["name", "sport", "team_id", "aliases"],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 2
      },
      "sport": {
        "type": "string",
        "const": "nba"
      },
      "position": {
        "type": "string"
      },
      "jersey_number": {
        "type": "string"
      },
      "nationality": {
        "type": "string"
      },
      "team_id": {
        "type": "string",
        "pattern": "^nba-[a-z]{2,4}$"
      },
      "metadata": {
        "type": "object",
        "required": ["team", "espn_player_id"],
        "properties": {
          "team": { "type": "string" },
          "espn_player_id": { "type": "string" },
          "height": { "type": "string" },
          "height_cm": { "type": "integer" },
          "weight_lbs": { "type": "integer" },
          "weight_kg": { "type": "integer" },
          "date_of_birth": { "type": "string" },
          "age": { "type": "integer" },
          "college": { "type": "string" },
          "years_experience": { "type": "integer" }
        }
      },
      "aliases": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["alias", "source_id"],
          "properties": {
            "alias": { "type": "string", "minLength": 1 },
            "source_id": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
