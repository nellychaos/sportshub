{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competitions",
  "description": "Array of competition/tournament objects",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "name", "short_name", "sport"],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 3
      },
      "name": {
        "type": "string",
        "minLength": 2
      },
      "short_name": {
        "type": "string",
        "minLength": 1
      },
      "sport": {
        "type": "string",
        "enum": ["nba", "lol", "football"]
      },
      "season": {
        "type": "string"
      },
      "region": {
        "type": "string"
      },
      "tier": {
        "type": "string"
      },
      "start_date": {
        "type": ["string", "null"]
      },
      "end_date": {
        "type": ["string", "null"]
      },
      "metadata": {
        "type": "object"
      }
    }
  }
}
