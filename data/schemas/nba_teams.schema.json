{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NBA Teams",
  "description": "Array of NBA team objects with metadata and aliases",
  "type": "array",
  "minItems": 30,
  "maxItems": 30,
  "items": {
    "type": "object",
    "required": ["name", "short_name", "abbreviation", "sport", "metadata", "aliases", "id"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^nba-[a-z]{2,4}$"
      },
      "name": {
        "type": "string",
        "minLength": 3
      },
      "short_name": {
        "type": "string",
        "minLength": 2
      },
      "abbreviation": {
        "type": "string",
        "pattern": "^[A-Z]{2,4}$"
      },
      "sport": {
        "type": "string",
        "const": "nba"
      },
      "metadata": {
        "type": "object",
        "required": ["conference", "division"],
        "properties": {
          "conference": { "type": "string", "enum": ["Eastern", "Western"] },
          "division": { "type": "string" },
          "team_color_primary": { "type": "string" },
          "team_color_secondary": { "type": "string" },
          "logo_url": { "type": "string", "format": "uri" },
          "espn_team_id": { "type": "string" },
          "arena": { "type": "string" },
          "arena_city": { "type": "string" },
          "arena_state": { "type": "string" },
          "head_coach": { "type": "string" }
        }
      },
      "aliases": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["alias", "source_id"],
          "properties": {
            "alias": { "type": "string", "minLength": 1 },
            "source_id": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
